    "section_html_8qVf3J": {
      "type": "section-html",
      "settings": {
        "html": "<div class=\"fit-finder-container\">\n  <iframe\n    id=\"fit-finder-iframe\"\n    src=\"https://fit-finder-topaz.vercel.app/\"\n    width=\"100%\"\n    height=\"3000\"\n    frameborder=\"0\"\n    style=\"border: none; border-radius: 8px; overflow: hidden\"\n    loading=\"lazy\"\n  >\n  </iframe>\n</div>\n\n\n<script>\n(function () {\n  var iframe = document.getElementById(\"fit-finder-iframe\");\n  if (!iframe) return;\n\n  var queued = false;\n\n  // The iframe is stretched to its full content height, so its own viewport\n  // covers the whole app and it cannot tell what is actually on screen. Tell\n  // it, so dropdowns can open into visible space instead of scrolling this\n  // page to reach themselves.\n  function sendViewport() {\n    queued = false;\n    if (!iframe.contentWindow) return;\n    iframe.contentWindow.postMessage(\n      {\n        type: \"PARENT_VIEWPORT\",\n        iframeTop: iframe.getBoundingClientRect().top,\n        viewportHeight: window.innerHeight\n      },\n      \"*\"\n    );\n  }\n\n  function queueViewport() {\n    if (queued) return;\n    queued = true;\n    requestAnimationFrame(sendViewport);\n  }\n\n  window.addEventListener(\"message\", function (e) {\n    if (!e.data) return;\n    if (e.data.type === \"IFRAME_HEIGHT_UPDATE\") {\n      iframe.style.height = e.data.height + \"px\";\n      queueViewport();\n    } else if (e.data.type === \"REQUEST_PARENT_VIEWPORT\") {\n      sendViewport();\n    }\n  });\n\n  window.addEventListener(\"scroll\", queueViewport, { passive: true });\n  window.addEventListener(\"resize\", queueViewport);\n  iframe.addEventListener(\"load\", sendViewport);\n  sendViewport();\n})();\n</script>",
        "width": "wrapper--none",
